<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:gravity="center">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- Official Kediri Safe Map Logo Image -->
        <ImageView
            android:id="@+id/imgSplashLogo"
            android:layout_width="260dp"
            android:layout_height="220dp"
            android:contentDescription="Logo Kediri Safe Map"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_kediri_safe" />

        <!-- Tagline -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="SATU PETA SATU INFORMASI"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:letterSpacing="0.12"
            android:textStyle="bold" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Sistem Tanggap Darurat &amp; Keamanan Warga"
            android:textColor="@color/text_muted"
            android:textSize="12.5sp" />

        <!-- Spinner Loading -->
        <ProgressBar
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="28dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/primary" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="24dp"
        android:text="Pemerintah Kota Kediri • Siaga 112"
        android:textColor="@color/text_muted"
        android:textSize="11.5sp"
        android:textStyle="bold" />

</RelativeLayout>
