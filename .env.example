# ========================================================
# KEDIRI SAFE MAP - ENVIRONMENT CONFIGURATION TEMPLATE
# ========================================================

# Application Configuration
APP_NAME="Kediri Safe Map"
APP_ENV=production
APP_URL=http://localhost:8080

# Database Configuration (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kediri_safe_map
DB_USERNAME=root
DB_PASSWORD=

# Government & Disaster API Integrations
BMKG_AUTOGEMPA_URL=https://data.bmkg.go.id/DataMKG/TEWS/autogempa.json
BMKG_WEATHER_KEDIRI_URL=https://api.bmkg.go.id/publik/prakiraan-cuaca?adm4=35.71.01.1001

# BPBD Kota Kediri API
BPBD_API_KEY=your_bpbd_api_key_here
BPBD_API_ENDPOINT=https://api.bpbd.kedirikota.go.id/v1/alerts

# Mapbox Access Token
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here

# WhatsApp Emergency Hotline Target
WHATSAPP_EMERGENCY_TARGET=628xxxxxxxxxx
