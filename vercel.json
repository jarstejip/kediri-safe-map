{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/alerts.php", "destination": "/api/alerts" },
    { "source": "/api/reports.php", "destination": "/api/reports" },
    { "source": "/api/register.php", "destination": "/api/register" },
    { "source": "/api/login.php", "destination": "/api/login" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
