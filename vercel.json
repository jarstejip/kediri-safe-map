{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/alerts.php", "destination": "/api/alerts" },
    { "source": "/api/reports.php", "destination": "/api/reports" },
    { "source": "/api/register.php", "destination": "/api/register" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
